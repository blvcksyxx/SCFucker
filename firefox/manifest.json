{
  "manifest_version": 2,
  "name": "SCFucker",
  "version": "1.0.0",
  "description": "Bypass SoundCloud geo-restrictions by routing API requests through a proxy.",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "*://*.soundcloud.com/*",
    "*://*.sndcdn.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hello@blvcksyxx.xyz",
      "strict_min_version": "91.0"
    }
  }
}
